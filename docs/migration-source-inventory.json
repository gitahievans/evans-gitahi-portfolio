          "level": "h1",
          "text": "LadyShelf"
        },
        {
          "level": "h2",
          "text": "Engineering brief"
        },
        {
          "level": "h2",
          "text": "System boundary"
        },
        {
          "level": "h2",
          "text": "Critical decisions"
        },
        {
          "level": "h3",
          "text": "Re-price and reserve stock inside one database transaction"
        },
        {
          "level": "h3",
          "text": "Treat payment as a state machine, not a redirect"
        },
        {
          "level": "h3",
          "text": "Separate authentication from the commerce profile"
        },
        {
          "level": "h3",
          "text": "Model staff work as a first-class product surface"
        },
        {
          "level": "h2",
          "text": "Failure design"
        },
        {
          "level": "h3",
          "text": "Commit before side effects"
        },
        {
          "level": "h3",
          "text": "Recover abandoned inventory"
        },
        {
          "level": "h3",
          "text": "Make AI work reviewable"
        },
        {
          "level": "h2",
          "text": "Production posture"
        },
        {
          "level": "h2",
          "text": "What this demonstrates"
        }
